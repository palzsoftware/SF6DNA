@@ -0,0 +1,29 @@
+"use client";
+
+import { useState } from "react";
+import { MoveMotionMedia } from "./move-motion-media";
+import type { MoveMotionMedia as MoveMotionMediaRecord } from "@/lib/move-motion-media";
+
+/**
+ * 同じ技カード内で「通常/チャージ/パーフェクト」などの動作パターンを切り替えて見せる。
+ * 既存の MoveMotionMedia(GIF/MP4の再生部品)をそのまま使い、選んだ1件だけを描画する(非表示パターンは読み込まない)。
+ */
+export function MoveMotionVariantTabs({ variants, title, className }: {
+  variants: Array<{ variantKey: string; label: string; media: MoveMotionMediaRecord }>;
+  title: string;
+  className?: string;
+}) {
+  const [active, setActive] = useState(variants[0].variantKey);
+  const current = variants.find(v => v.variantKey === active) ?? variants[0];
+  return (
+    <>
+      <div role="tablist" aria-label={`${title}の動作パターン`}>
+        {variants.map(v => (
+          <button key={v.variantKey} type="button" role="tab" aria-selected={v.variantKey === current.variantKey}
+            onClick={() => setActive(v.variantKey)}>{v.label}</button>
+        ))}
+      </div>
+      <MoveMotionMedia key={current.media.mediaUrl} media={current.media} title={`${title}（${current.label}）`} className={className} />
+    </>
+  );
+}
