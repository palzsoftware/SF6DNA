+export function unifiedMoveMediaVariants(move: UnifiedMove) {
+  const base = unifiedMoveMedia(move);
+  const variants = (move.mediaVariants ?? []).filter(v =>
+    v.media.moveId === move.id && typeof v.media.mediaUrl === "string" && v.media.mediaUrl.trim());
